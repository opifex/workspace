# containers prefix
PREFIX=workspace

# httpbin configuration
HTTPBIN_TAG=2.26.0

# mockserver configuration
MOCKSERVER_TAG=latest

# mailpit configuration
MAILPIT_TAG=v1.32.0
MAILPIT_PORT=25

# mariadb configuration
MARIADB_TAG=13.0
MARIADB_PORT=3306
MARIADB_VOLUME=mariadb

# mongo configuration
MONGO_TAG=9.0.4
MONGO_PORT=27017
MONGO_VOLUME=mongo

# nginx configuration
NGINX_TAG=latest
NGINX_PORT=80

# postgres configuration
POSTGRES_TAG=18.6
POSTGRES_PORT=5432
POSTGRES_VOLUME=postgres

# rabbit configuration
RABBITMQ_TAG=4.4.0-management
RABBITMQ_PORT=5672
RABBITMQ_VOLUME=rabbitmq

# redis configuration
REDIS_TAG=latest
REDIS_PORT=6379
REDIS_VOLUME=redis
